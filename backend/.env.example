PORT=4000
# Only needed when the frontend is hosted separately from the backend.
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# Optional: email for attendance reports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@example.com
SMTP_PASS=your-smtp-or-app-password
SMTP_FROM=your-address@example.com
